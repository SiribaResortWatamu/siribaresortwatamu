# ---------------------------------------------------------------------
# Supabase
# Project Settings -> API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser — every booking, price
# and availability check runs through it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Email (Resend) — optional at launch. Without it, notifications are
# logged to the server console instead of being sent.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Siriba Resort Watamu <bookings@yourdomain.co.ke>"

# ---------------------------------------------------------------------
# Scheduled jobs (calendar sync, hold expiry, guest messages).
# Vercel Cron sends this as a bearer token.
# ---------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string
